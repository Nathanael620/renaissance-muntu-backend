<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Stripe isolated">
            <file>tests/Unit/DonationCurrencyAmountTest.php</file>
            <file>tests/Unit/StripeDonationServiceTest.php</file>
            <file>tests/Feature/DonationCheckoutTest.php</file>
            <file>tests/Feature/StripeWebhookTest.php</file>
            <file>tests/Feature/DonationStatusTest.php</file>
            <file>tests/Feature/DonationReceiptEmailOutboxTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="DONATION_CURRENCY" value="cad" force="true"/>
        <env name="DONATION_MIN_AMOUNT" value="5" force="true"/>
        <env name="DONATION_MAX_AMOUNT" value="10000" force="true"/>
        <env name="FRONTEND_URL" value="http://localhost:5173" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="MAIL_URL" value="" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="STRIPE_SECRET_KEY" value="" force="true"/>
        <env name="STRIPE_PUBLISHABLE_KEY" value="" force="true"/>
        <env name="STRIPE_WEBHOOK_SECRET" value="" force="true"/>
        <env name="CHARITY_AUTHORIZED_SIGNATORY" value="" force="true"/>
        <env name="RECEIPT_NUMBER_PREFIX" value="TEST-" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
