APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# URL of the React frontend (allowed origin for CORS).
FRONTEND_URL=http://localhost:5173

# Recipient of the contact-form notification email (never hard-coded).
CONTACT_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Stripe (https://dashboard.stripe.com/apikeys).
# Never commit real keys; copy them into your local .env only.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Endpoint signing secret (https://dashboard.stripe.com/webhooks).
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Donations
# ---------------------------------------------------------------------------
# Payment currency validated server-side (e.g. cad, usd, eur).
DONATION_CURRENCY=
# Server-side amount limits in the currency above.
DONATION_MIN_AMOUNT=
DONATION_MAX_AMOUNT=
# Official authorized signatory of donation receipts. Must be confirmed
# officially by the organization before production — never assume it.
CHARITY_AUTHORIZED_SIGNATORY=
# Prefix used to generate official receipt numbers.
RECEIPT_NUMBER_PREFIX=

# Base URL of the Laravel API used by the React frontend.
VITE_API_URL=http://localhost:8000/api

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Elimb'a Dikalo — Renaissance Muntu"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
